{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMW Learning Track",
  "description": "A staged path for one language or for the shared core. Validated by .emw/tools/emw_check.py, which also checks rules a schema cannot express (skill ids resolve, targets never go down, brief files exist).",
  "type": "object",
  "required": ["schema_version", "id", "title", "summary", "skills", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 10},
    "extends": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "framework": {"type": "string"},
    "researched_at": {"type": "string", "format": "date"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "gate": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "scope"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 3},
          "scope": {"enum": ["S1", "S2", "S3"]},
          "covers": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "name", "outcome", "default_mode", "skills", "project"],
        "properties": {
          "number": {"type": "integer", "minimum": 0, "maximum": 9},
          "name": {"type": "string", "minLength": 3},
          "outcome": {"type": "string", "minLength": 10},
          "duration_estimate": {"type": "string"},
          "default_mode": {"type": "integer", "minimum": 1, "maximum": 4},
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "target"],
              "properties": {
                "id": {"type": "string"},
                "target": {"enum": ["M1", "M2", "M3", "M4"]}
              },
              "additionalProperties": false
            }
          },
          "project": {
            "type": "object",
            "required": ["title", "brief"],
            "properties": {
              "title": {"type": "string", "minLength": 3},
              "brief": {"type": "string", "pattern": "\\.md$"}
            },
            "additionalProperties": false
          },
          "electives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "summary"],
              "properties": {
                "title": {"type": "string"},
                "summary": {"type": "string"},
                "learn_only": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "resources": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
